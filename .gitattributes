# Files that are executed on Linux must keep LF endings regardless of the
# platform they are checked out or archived on.
#
# Without this, a Windows checkout stores CRLF into `git archive` output, and a
# shell script shipped to a Linux host dies at its first line with
# "set: pipefail: invalid option name" -- a failure that points nowhere near the
# real cause. The same applies to anything an interpreter or daemon reads
# line-by-line inside a container.

*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
docker-compose*.yml text eol=lf
Caddyfile       text eol=lf
*.conf          text eol=lf
*.conf.template text eol=lf

# Host automation installed by deploy/ops/install.sh: shell, python and systemd
# units read on the production host.
deploy/ops/**  text eol=lf
