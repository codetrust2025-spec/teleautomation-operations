SERVICE_NAME=teleautomation-operations
TELEAUTOMATION_SAFE_UI_MODE=false
OPERATIONS_DATA_DIR=/var/lib/teleautomation-operations
DATABASE_URL=
OPERATIONS_PUBLIC_URL=
MARKETING_PUBLIC_URL=

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_AUTH_SECRET=
DASHBOARD_COOKIE_SECURE=true
OPS_API_TOKEN=
INTERNAL_SERVICE_TOKEN=
MESSAGING_INTERNAL_URL=http://127.0.0.1:8000

# Attendance marking fails closed until the approved office public address is
# configured. Use comma-separated public IPv4/IPv6 CIDRs. Forwarded client
# addresses are accepted only when the direct peer is in the separately
# configured trusted-proxy list; never put browser/client addresses there.
OPERATIONS_OFFICE_NETWORK_CIDRS=
OPERATIONS_TRUSTED_PROXY_CIDRS=
# Optional rollout boundary; defaults to the date migration 028 is applied.
OPERATIONS_ATTENDANCE_EFFECTIVE_DATE=

AI_INTERVIEW_OFFER_TRACKING_ENABLED=false
AI_INTERVIEW_AUTO_BOOKING_ENABLED=false
AI_INTERVIEW_DEFAULT_DURATION_MINUTES=60
AI_INTERVIEW_DEFAULT_TIMEZONE=Asia/Kolkata
AI_INTERVIEW_DEFAULT_TIMEZONE_DOMAINS=
AI_INTERVIEW_MANUAL_DEFAULT_TIMEZONE=Asia/Kolkata
AI_MAILBOX_SYNC_ENABLED=false
AI_MAIL_SYNC_INTERVAL_MINUTES=5
AI_MAIL_SYNC_BATCH_SIZE=50
AI_MAIL_SYNC_MAX_CONCURRENCY=2
AI_MAIL_SYNC_MAX_RETRIES=5
AI_MAIL_INGESTION_LEASE_MINUTES=10
AI_MAIL_MAX_AI_ATTEMPTS=5
AI_MAIL_AI_LEASE_SECONDS=300
AI_MAIL_AI_RETRY_BATCH_SIZE=10
# AI_MAIL_RECONCILIATION_MAX_MESSAGES caps a Gmail *ingestion* backfill. Despite
# the name it has nothing to do with the removed Payment Reconciliation page.
AI_MAIL_RECONCILIATION_MAX_MESSAGES=500
AI_OFFER_VERIFICATION_ENABLED=false
AI_RECRUITMENT_MODEL=
AI_RECRUITMENT_FALLBACK_MODEL=
AI_RECRUITMENT_AUTO_ACCEPT_THRESHOLD=0.9
AI_RECRUITMENT_JOB_TIMEOUT_SECONDS=120
AI_RECRUITMENT_REQUEST_TIMEOUT_SECONDS=60

GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=
MAILBOX_CREDENTIAL_ENCRYPTION_KEY=

OLLAMA_PRIMARY_NODE=
OLLAMA_NODE_VPS_LOCAL_URL=http://127.0.0.1:11434
OLLAMA_NODE_OUR_MACHINE_URL=
OLLAMA_NODE_JAGADEESH_URL=
OLLAMA_NODE_RTX4060_URL=
OLLAMA_MODEL_NODE_PREFERENCE=
OLLAMA_REASONING_MODEL=
OLLAMA_MAIL_MODEL=
OLLAMA_FALLBACK_MODEL=
OLLAMA_BACKUP_VISION_MODEL=
OLLAMA_REMOTE_ENABLED=false
OLLAMA_EXPECT_REVERSE_SSH_TUNNEL=false
OLLAMA_REQUEST_TIMEOUT=60
OLLAMA_TEXT_TIMEOUT=60
OLLAMA_RESUME_TEXT_TIMEOUT=90
OLLAMA_TIMEOUT=60
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NODE_FAILURE_THRESHOLD=3
OLLAMA_NODE_COOLDOWN_SECONDS=60
OLLAMA_CONFIDENCE_THRESHOLD=0.7
AI_OLLAMA_MAX_CONCURRENCY=2

OCR_ENABLED=false
OCR_POLICY_FILE=
PAYMENT_VERIFICATION_OCR_ENABLED=false
INVITE_EXTRACTION_MODE=manual
INVITE_EXTRACTION_TIMEOUT=60
SLOT_PARSE_VISION_MODEL=
SLOT_PARSE_VISION_RETRIES=1

PAYMENT_ENGINE_V2_ENABLED=false
PAYMENT_EVIDENCE_ROOT=
PAYMENT_EVIDENCE_MAX_BYTES=10485760
PAYMENT_EXTRACTION_PROVIDER=ollama
PAYMENT_MIN_EXTRACTION_CONFIDENCE=0.8
PAYMENT_RECEIVER_REGISTRY_FILE=
PAYMENT_VERIFICATION_LEDGER_FILE=
PAYMENT_RECALCULATION_AUDIT_FILE=
PAYMENT_DEFAULT_COMMISSION_PCT=0
PAYMENT_COMMISSION_RULES_JSON=
PAYMENT_REFERRER_RECEIVERS_JSON=
REFERRER_RECEIVER_FLOW_ENABLED=false
REFERRER_REGISTRY_FILE=
# Receiver identifiers that may accept company payments. Comma-separated.
# REQUIRED in any real deployment. Left empty, COMPANY_PAYMENT_UPI_IDS falls
# back to the placeholder company@upi in features/company_payment_verification.py,
# and every genuine receipt is then refused with RECEIVER_IDENTIFIER_CONFLICT:
# the payee name matches the registry while the visible handle does not.
# Setting a real value replaces the placeholder entirely. Phone numbers have no
# placeholder: left empty, no phone identifies the company (the old 9000000001
# fallback registered a number that was never the company's).
COMPANY_PAYMENT_UPI_IDS=
COMPANY_PAYMENT_PHONE_NUMBERS=
COMPANY_PAYMENT_ACCOUNT_NUMBERS=
# Names the payee may print for the company receiver. Comma-separated; the
# first is the display name and the rest are aliases.
COMPANY_PAYMENT_RECEIVER_NAMES=

INTERVIEW_REMINDERS_ENABLED=false

HISTORICAL_BOOKING_RECORDS_FILE=
STAFF_DIRECTORY_FILE=
TELEAUTOMATION_OPERATOR_EMAIL=
